# Allowlist: the build context is only the Rust build inputs. Everything else in the
# repository (data/, .tools/, .venv/, target/, out*/, reference/, scripts/,
# fixtures/, dev-answer/, archives, docs and VCS data) is excluded by the leading *.
*
!Cargo.toml
!Cargo.lock
!src/
!src/**
!.cargo/
!.cargo/config.toml
